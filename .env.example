# Copy this file to `.env` and fill in only the secrets you intend to use.
# `.env` is gitignored; never commit real credentials.
#
#   cp .env.example .env
#
# IMPORTANT: Keep single/double quotes around values with spaces (e.g. APP_NAME,
# DEFAULT_PERSONA_TONE) so `uv run --env-file .env` parses the whole file cleanly.
#
# Every secret below is optional. With no keys the assistant still runs using
# its deterministic rule-based fallback and the simulated BigQuery dataset.

# --- Application ---
APP_NAME='Retail Data Analysis Assistant'
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM Providers & Resilience ---
# Primary provider. Gemini is used when GOOGLE_API_KEY is set.
# Tip: If `gemini-2.5-flash` returns transient `503 UNAVAILABLE` high-demand errors,
# switch temporarily to `gemini-2.5-flash-lite` or configure a fallback provider below.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenRouter fallback (initialized when OPENROUTER_API_KEY is set).
# Choose a model that supports JSON-schema structured outputs (e.g. `openai/gpt-4o-mini`
# or `google/gemini-2.5-flash`), as some `:free` models reject structured output schemas.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenAI fallback (initialized when OPENAI_API_KEY is set).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=15

# --- BigQuery (bigquery-public-data.thelook_ecommerce) ---
# Set BIGQUERY_MOCK_MODE=false and provide your GCP billing project ID for live queries.
GCP_PROJECT_ID=
BQ_DATASET_ID=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES_BILLED=1073741824
BQ_QUERY_TIMEOUT_SECONDS=30
# Keep true for a credential-free evaluation. Set false to query real BigQuery.
BIGQUERY_MOCK_MODE=true
# BigQuery auth when BIGQUERY_MOCK_MODE=false (choose ONE):
# 1. Service Account JSON (local --standalone, keep file OUTSIDE the git repo, chmod 600):
#    GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/.config/gcp/bigquery-sa.json
# 2. gcloud ADC (`gcloud auth application-default login`):
#    Leave GOOGLE_APPLICATION_CREDENTIALS commented out (if set to a missing path, GCP SDK fails).
# 3. Docker Compose (mount the JSON file into the container):
#    GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-sa.json

# --- Persistence (saved reports) ---
# Used by docker compose. Local `--standalone` runs default to SQLite below.
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail_secret_pass
POSTGRES_DB=retail_assistant
DATABASE_URL=sqlite+aiosqlite:///./retail_local.db

# --- Redis (cache, HITL confirmation tokens, session memory) ---
# For Zero-Docker `--standalone` runs without Redis, leave REDIS_URL= empty to use
# in-memory TTL storage directly without connection warnings (otherwise falls back after 60s cooldown).
REDIS_URL=redis://localhost:6379/0
CONFIRMATION_TTL_SECONDS=600
CACHE_TTL_SECONDS=300

# --- Agent Guardrails, CLI & Resilience ---
PROTOTYPE_USER_PROFILE=brand_manager_alice
CLI_TIMEOUT_SECONDS=120
MAX_SQL_RETRIES=3
MAX_LLM_CALLS_PER_TURN=5
MAX_TURN_COST_USD=1.0
DEFAULT_ROW_LIMIT=200
DEFAULT_PERSONA_TONE='Executive, concise, data-driven, and action-oriented'
DEMOGRAPHIC_MIN_GROUP_SIZE=5

# --- Observability ---
TRACE_LOG_PATH=logs/agent_traces.jsonl
# LangSmith (read directly by LangChain, not by Settings)
# Sends masked agent traces to LangSmith cloud when tracing is enabled.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=retailassesment
LANGSMITH_AGENT_ENVIRONMENT=local
